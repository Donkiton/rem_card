  "flows": [
    {
      "id": "role_startup",
      "name": "Запуск роли до отображения рабочего места",
      "trigger": "Пользователь запускает приложение по умолчанию или точку запуска конкретной роли.",
      "steps": [
        "entrypoints",
        "startup_runtime",
        "ui_shell",
        "doctor_ui"
      ],
      "outcome": "Защищённый процесс Qt получает владение экземпляром роли и показывает выбранное рабочее место; путь врача представлен как основной, а ветви медсестры и операционного блока выходят из той же оболочки."
    },
    {
      "id": "clinical_write",
      "name": "Клиническая запись медсестры и обновление",
      "trigger": "Медсестра изменяет лабораторное назначение или другое поле общей карты пациента.",
      "steps": [
        "nurse_ui",
        "clinical_ui",
        "clinical_services",
        "data_change_bus",
        "medical_db"
      ],
      "outcome": "Запись выполняется транзакционно, после чего DataService планирует классифицированное обновление затронутых экранов."
    },
    {
      "id": "operblock_protocol",
      "name": "Действие в протоколе операционного блока",
      "trigger": "Пользователь операционного блока запускает этап случая, записывает показатель или изменяет препарат либо инфузию.",
      "steps": [
        "operblock_ui",
        "operblock_domain",
        "medical_db",
        "local_replica"
      ],
      "outcome": "Транзакция с проверкой конфликтов фиксируется в медицинской БД, а локальная реплика получает запрос на ускоренную синхронизацию."
    },
    {
      "id": "local_first_refresh",
      "name": "Обнаружение изменений между клиентами и локальное чтение",
      "trigger": "Фоновый монитор выполняет опрос по таймеру или после успешной записи.",
      "steps": [
        "data_change_bus",
        "medical_db",
        "local_replica",
        "data_change_bus",
        "nurse_ui"
      ],
      "outcome": "Изменения с учётом курсора классифицируются, а интерфейс медсестры применяет адресное или частичное обновление без перестроения несвязанных представлений."
    },
    {
      "id": "emergency_fallback",
      "name": "Переход от потери сети к аварийной среде",
      "trigger": "При запуске медицинская сетевая БД классифицируется как недоступная для подходящей роли.",
      "steps": [
        "startup_runtime",
        "emergency_runtime",
        "medical_db"
      ],
      "outcome": "Для сессии открывается проверенная локальная среда медицинской БД и настроек, сохранённая для последующего восстановления или объединения."
    }
  ]
}
